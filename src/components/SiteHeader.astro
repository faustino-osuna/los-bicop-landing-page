---
import { Button } from './starwind/button';
import {
	Sheet,
	SheetClose,
	SheetContent,
	SheetDescription,
	SheetHeader,
	SheetTitle,
	SheetTrigger,
} from './starwind/sheet';

const instagramUrl = 'https://www.instagram.com/losbicop/';
const spotifyUrl = 'https://open.spotify.com/intl-es/artist/0CphSb0BsY0MgnzvU7rxpY';
---

<header class="site-header">
	<a class="brand" href="#inicio" aria-label="Los Bicop, inicio">
		<img src={`${import.meta.env.BASE_URL}img/los-bicop-logo.jpg`} alt="" width="42" height="42" />
		<span>LOS <strong>BICOP</strong></span>
	</a>

	<nav class="navigation" aria-label="Navegación principal">
		<a href="#videoclip">Videoclip</a>
	</nav>

	<div class="header-socials">
		<a class="instagram-link" href={instagramUrl} target="_blank" rel="noreferrer">
			<svg class="instagram-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.7" />
				<circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7" />
				<circle cx="17.5" cy="6.8" r="1" fill="currentColor" />
			</svg>
			<span>Instagram</span>
		</a>
		<a class="spotify-link" href={spotifyUrl} aria-label="Escúchanos en Spotify" target="_blank">
			<svg class="spotify-icon" viewBox="0 0 24 24" aria-hidden="true">
				<circle cx="12" cy="12" r="10" fill="currentColor" />
				<path d="M6.4 9.2c3.7-1.1 7.9-.7 11.1 1.2M7.2 12.1c3.1-.9 6.4-.5 9.2 1M8 14.9c2.4-.7 4.9-.4 7 .8" fill="none" stroke="var(--color-bicop-night)" stroke-linecap="round" stroke-width="1.6" />
			</svg>
			<span>Spotify</span>
		</a>
	</div>

	<Sheet class="mobile-menu">
		<SheetTrigger asChild>
			<Button
				variant="outline"
				size="icon"
				class="mobile-menu-trigger"
				aria-label="Abrir menú principal"
			>
				<span class="menu-icon" aria-hidden="true"><span></span></span>
			</Button>
		</SheetTrigger>
		<SheetContent side="right" class="mobile-sheet">
			<SheetHeader class="mobile-sheet-header">
				<SheetTitle>Los Bicop</SheetTitle>
				<SheetDescription>Navegación principal</SheetDescription>
			</SheetHeader>
			<nav class="mobile-navigation" aria-label="Navegación móvil">
				<SheetClose asChild><a href="#videoclip">Ver videoclip</a></SheetClose>
				<SheetClose asChild>
					<a class="mobile-instagram" href={instagramUrl} target="_blank" rel="noreferrer">
						<svg class="instagram-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.7" />
							<circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7" />
							<circle cx="17.5" cy="6.8" r="1" fill="currentColor" />
						</svg>
						<span>Instagram</span>
					</a>
				</SheetClose>
				<SheetClose asChild>
					<a class="mobile-spotify" href={spotifyUrl} aria-label="Escúchanos en Spotify" target="_blank">
						<svg class="spotify-icon" viewBox="0 0 24 24" aria-hidden="true">
							<circle cx="12" cy="12" r="10" fill="currentColor" />
							<path d="M6.4 9.2c3.7-1.1 7.9-.7 11.1 1.2M7.2 12.1c3.1-.9 6.4-.5 9.2 1M8 14.9c2.4-.7 4.9-.4 7 .8" fill="none" stroke="var(--color-bicop-night)" stroke-linecap="round" stroke-width="1.6" />
						</svg>
						<span>Escúchanos en Spotify</span>
					</a>
				</SheetClose>
			</nav>
		</SheetContent>
	</Sheet>
</header>

<style>
	.site-header {
		position: fixed;
		z-index: 40;
		top: 0;
		left: 0;
		display: grid;
		width: calc(100% - var(--sw-scrollbar-width, 0px));
		min-height: 88px;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		padding-inline: 6.2%;
		border-bottom: 1px solid rgb(255 255 255 / 12%);
		background: color-mix(in srgb, var(--color-bicop-night) 58%, transparent);
		backdrop-filter: blur(14px) saturate(130%);
	}

	.brand,
	.navigation,
	.header-socials {
		display: flex;
		align-items: center;
	}

	.brand {
		width: fit-content;
		gap: 11px;
		color: var(--color-bicop-ice);
		font-size: 13px;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-decoration: none;
	}

	.brand img {
		width: 42px;
		height: 42px;
		border: 1px solid rgb(255 255 255 / 18%);
		border-radius: 50%;
		object-fit: cover;
	}

	.navigation {
		gap: clamp(20px, 2.5vw, 36px);
	}

	.navigation a {
		color: var(--color-bicop-chrome);
		font-size: 14px;
		text-decoration: none;
		transition: color 180ms ease, text-shadow 180ms ease;
	}

	.navigation a:hover {
		color: var(--color-bicop-ice);
		text-shadow: 0 0 16px color-mix(in srgb, var(--color-bicop-violet) 45%, transparent);
	}

	.header-socials {
		justify-self: end;
		gap: clamp(8px, 1vw, 12px);
	}

	.instagram-link,
	.spotify-link {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		padding: 10px 15px;
		border: 1px solid color-mix(in srgb, var(--color-bicop-chrome) 34%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--color-bicop-stage) 48%, transparent);
		color: var(--color-bicop-ice);
		font-size: 13px;
		text-decoration: none;
		transition:
			border-color 180ms ease,
			background-color 180ms ease,
			box-shadow 180ms ease,
			color 180ms ease;
	}

	.instagram-icon {
		width: 16px;
		height: 16px;
		color: var(--color-bicop-violet);
	}

	.spotify-link {
		border-color: color-mix(in srgb, var(--color-bicop-chrome) 26%, transparent);
		color: var(--color-bicop-chrome);
	}

	.spotify-icon {
		width: 18px;
		height: 18px;
		color: var(--color-bicop-chrome);
		transition: color 180ms ease;
	}

	.instagram-link:hover {
		border-color: color-mix(in srgb, var(--color-bicop-violet) 74%, transparent);
		background: color-mix(in srgb, var(--color-bicop-stage) 76%, transparent);
		box-shadow: 0 0 20px color-mix(in srgb, var(--color-bicop-electric) 20%, transparent);
	}

	.spotify-link:hover {
		border-color: color-mix(in srgb, #1ed760 72%, transparent);
		background: color-mix(in srgb, var(--color-bicop-stage) 76%, transparent);
		box-shadow: 0 0 18px color-mix(in srgb, #1ed760 17%, transparent);
		color: var(--color-bicop-ice);
	}

	.spotify-link:hover .spotify-icon {
		color: #1ed760;
	}

	.site-header :global(.mobile-menu) {
		display: contents;
	}

	.site-header :global(.mobile-menu-trigger) {
		display: none;
	}

	.brand:focus-visible,
	.navigation a:focus-visible,
	.instagram-link:focus-visible,
	.spotify-link:focus-visible {
		outline: 2px solid var(--color-bicop-violet);
		outline-offset: 4px;
	}

	.navigation a:focus-visible {
		color: var(--color-bicop-ice);
		text-shadow: 0 0 16px color-mix(in srgb, var(--color-bicop-violet) 45%, transparent);
	}

	@media (max-width: 760px) {
		.site-header {
			min-height: 76px;
			grid-template-columns: 1fr auto;
			padding: 12px 6%;
		}

		.navigation {
			display: none;
		}

		.header-socials {
			display: none;
		}

		.site-header :global(.mobile-menu) {
			display: block;
			justify-self: end;
		}

		.site-header :global(.mobile-menu-trigger) {
			display: inline-flex;
			border-color: rgb(255 255 255 / 20%);
			border-radius: 50%;
			background: var(--color-bicop-night);
			color: var(--color-bicop-ice);
		}

		.site-header :global(.mobile-menu-trigger:hover) {
			background: var(--color-bicop-stage);
			color: var(--color-bicop-ice);
		}

		.menu-icon {
			position: relative;
			display: block;
			width: 18px;
			height: 1px;
			background: currentColor;
		}

		.menu-icon::before,
		.menu-icon::after {
			position: absolute;
			left: 0;
			width: 18px;
			height: 1px;
			background: currentColor;
			content: "";
		}

		.menu-icon::before {
			top: -6px;
		}

		.menu-icon::after {
			top: 6px;
		}

		.site-header :global(.mobile-sheet) {
			border-color: rgb(255 255 255 / 14%);
			background: var(--color-bicop-night);
			color: var(--color-bicop-ice);
		}

		.site-header :global(.mobile-sheet-header) {
			padding: 28px 24px 18px;
		}

		.site-header :global(.mobile-navigation) {
			display: grid;
			gap: 4px;
			padding: 8px 24px;
		}

		.site-header :global(.mobile-navigation a) {
			display: flex;
			min-height: 48px;
			align-items: center;
			padding: 12px 0;
			border-bottom: 1px solid rgb(255 255 255 / 10%);
			color: var(--color-bicop-chrome);
			font-size: 16px;
			text-decoration: none;
			transition: color 180ms ease, border-color 180ms ease;
		}

		.site-header :global(.mobile-navigation a:hover) {
			color: var(--color-bicop-ice);
			border-color: color-mix(in srgb, var(--color-bicop-violet) 42%, transparent);
		}

		.site-header :global(.mobile-navigation .mobile-instagram) {
			display: flex;
			gap: 10px;
			margin-top: 12px;
			border-bottom: 0;
			color: var(--color-bicop-ice);
		}

		.site-header :global(.mobile-navigation .mobile-spotify) {
			display: flex;
			gap: 10px;
			border-bottom: 0;
			color: var(--color-bicop-chrome);
			transition: color 180ms ease;
		}

		.site-header :global(.mobile-instagram .instagram-icon) {
			flex: 0 0 auto;
		}

		.site-header :global(.mobile-spotify .spotify-icon) {
			flex: 0 0 auto;
		}

		.site-header :global(.mobile-spotify:hover) {
			color: var(--color-bicop-ice);
		}

		.site-header :global(.mobile-spotify:hover .spotify-icon) {
			color: #1ed760;
		}

		.site-header :global(.mobile-navigation a:focus-visible) {
			border-radius: 2px;
			outline: 2px solid var(--color-bicop-violet);
			outline-offset: 3px;
			color: var(--color-bicop-ice);
		}

		.brand {
			gap: 8px;
			font-size: 11px;
		}

		.brand img {
			width: 35px;
			height: 35px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.navigation a,
		.instagram-link,
		.spotify-link,
		.spotify-icon,
		.site-header :global(.mobile-navigation a) {
			transition: none;
		}
	}
</style>
