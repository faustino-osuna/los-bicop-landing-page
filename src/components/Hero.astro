---
import { Button } from "./starwind/button";
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
	<div class="hero-grid" aria-hidden="true"></div>
	<div class="hero-atmosphere" aria-hidden="true"></div>

	<figure class="hero-photo">
		<img
			src={`${import.meta.env.BASE_URL}img/los-bicop.jpg`}
			alt="Los integrantes de Los Bicop reunidos bajo luces azules y violetas"
			width="1500"
			height="2048"
			fetchpriority="high"
		/>
	</figure>

	<div class="hero-lockup">
		<h1 class="hero-wordmark" id="hero-title">
			<span>LOS</span>
			<span>BICOP<span class="wordmark-period" aria-hidden="true">.</span></span>
		</h1>

		<div class="hero-action">
			<p class="hero-descriptor">Danza urbana <span aria-hidden="true"></span> Música</p>
			<Button as="a" href="#videoclip" variant="outline" size="md" class="hero-cta">
				<span>Ver videoclip</span>
				<svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="M5.45 3.55a.7.7 0 0 1 1.1-.57l6.1 4.45a.7.7 0 0 1 0 1.14l-6.1 4.45a.7.7 0 0 1-1.1-.57V3.55Z" fill="currentColor" />
				</svg>
			</Button>
		</div>
	</div>
</section>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const hero = document.querySelector<HTMLElement>(".hero");
	const photo = hero?.querySelector<HTMLElement>(".hero-photo");
	const wordmark = hero?.querySelector<HTMLElement>(".hero-wordmark");
	const action = hero?.querySelector<HTMLElement>(".hero-action");

	if (hero && photo && wordmark && action) {
		const motion = gsap.matchMedia();

		motion.add("(prefers-reduced-motion: no-preference)", () => {
			gsap
				.timeline({ defaults: { ease: "power3.out" } })
				.fromTo(
					photo,
					{ autoAlpha: 0, scale: 1.045, y: 24 },
					{ autoAlpha: 1, scale: 1, y: 0, duration: 1.2 },
				)
				.fromTo(
					wordmark,
					{ autoAlpha: 0, y: 34 },
					{ autoAlpha: 1, y: 0, duration: 0.85 },
					"-=0.65",
				)
				.fromTo(
					action,
					{ autoAlpha: 0, y: 18 },
					{ autoAlpha: 1, y: 0, duration: 0.7 },
					"-=0.35",
				);

			gsap
				.timeline({
					scrollTrigger: {
						trigger: hero,
						start: "top top",
						end: "bottom top",
						scrub: 0.8,
					},
				})
				.to(photo, { yPercent: 5, scale: 1.035, ease: "none" }, 0)
				.to(wordmark, { yPercent: -12, ease: "none" }, 0);
		});
	}
</script>

<style>
	@media (prefers-reduced-motion: no-preference) {
		:global(html[data-hero-motion="enabled"]) .hero-photo,
		:global(html[data-hero-motion="enabled"]) .hero-wordmark,
		:global(html[data-hero-motion="enabled"]) .hero-action {
			visibility: hidden;
		}
	}

	.hero {
		position: relative;
		display: flex;
		min-height: max(760px, 100svh);
		overflow: hidden;
		align-items: center;
		background:
			radial-gradient(
				ellipse at 50% 54%,
				color-mix(in srgb, var(--color-bicop-violet) 15%, transparent),
				transparent 48%
			),
			var(--color-bicop-night);
		isolation: isolate;
	}

	.hero-grid {
		position: absolute;
		z-index: -1;
		inset: 0;
		background-image:
			linear-gradient(rgb(255 255 255 / 2%) 1px, transparent 1px),
			linear-gradient(90deg, rgb(255 255 255 / 2%) 1px, transparent 1px);
		background-size: 70px 70px;
		mask-image: linear-gradient(90deg, transparent, #000 55%, transparent);
	}

	.hero-atmosphere {
		position: absolute;
		z-index: -1;
		top: 28%;
		left: 50%;
		width: 340px;
		aspect-ratio: 1;
		transform: translateX(-50%);
		border-radius: 50%;
		background: var(--color-bicop-electric);
		filter: blur(190px);
		opacity: 0.2;
	}

	.hero-photo {
		--photo-mask:
			linear-gradient(to right, transparent 0%, #000 19%, #000 81%, transparent 100%),
			linear-gradient(to bottom, transparent 0%, #000 15%, #000 82%, transparent 100%);

		position: absolute;
		top: 11%;
		left: 50%;
		width: min(66vw, 760px);
		height: min(82svh, 760px);
		min-height: 560px;
		margin: 0;
		transform: translateX(-50%);
	}

	.hero-photo::after {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgb(8 9 16 / 12%), transparent 28%, rgb(8 9 16 / 42%)),
			linear-gradient(90deg, rgb(8 9 16 / 12%), transparent 40%);
		-webkit-mask-image: var(--photo-mask);
		-webkit-mask-composite: source-in;
		mask-image: var(--photo-mask);
		mask-composite: intersect;
		content: "";
		pointer-events: none;
	}

	.hero-photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 49%;
		-webkit-mask-image: var(--photo-mask);
		-webkit-mask-composite: source-in;
		mask-image: var(--photo-mask);
		mask-composite: intersect;
	}

	.hero-wordmark {
		display: flex;
		flex-direction: column;
		margin: 0;
		color: var(--color-bicop-ice);
		font-family: "Arial Black", "Helvetica Neue", sans-serif;
		font-size: clamp(98px, 15vw, 120px);
		font-weight: 900;
		letter-spacing: -0.105em;
		line-height: 0.7;
		pointer-events: none;
		text-shadow: 0 12px 52px rgb(0 0 0 / 32%);
	}

	.hero-lockup {
		position: absolute;
		z-index: 3;
		bottom: clamp(20px, 2.4vw, 32px);
		left: 50%;
		display: flex;
		width: max-content;
		max-width: calc(100% - 32px);
		flex-direction: column;
		align-items: center;
		gap: clamp(18px, 2.2vw, 26px);
		transform: translateX(-50%);
	}

	.hero-wordmark > span:first-child {
		margin-bottom: 0.16em;
		font-size: 0.43em;
		letter-spacing: -0.045em;
	}

	.hero-action {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 13px;
	}

	.hero-descriptor {
		display: flex;
		align-items: center;
		gap: 9px;
		margin: 0;
		color: var(--color-bicop-chrome);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.14em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.hero-descriptor span {
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: var(--color-bicop-violet);
		box-shadow: 0 0 10px color-mix(in srgb, var(--color-bicop-violet) 70%, transparent);
	}

	.hero-cta {
		display: inline-flex;
		height: auto;
		min-height: 48px;
		align-items: center;
		justify-content: center;
		gap: 14px;
		padding: 0 19px;
		border: 1px solid color-mix(in srgb, var(--color-bicop-violet) 42%, transparent);
		border-radius: 999px;
		background: rgb(8 9 16 / 78%);
		backdrop-filter: blur(12px) saturate(135%);
		box-shadow: 0 8px 26px rgb(0 0 0 / 28%);
		color: var(--color-bicop-ice);
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 0.045em;
		text-decoration: none;
		transition:
			background-color 180ms ease,
			border-color 180ms ease,
			color 180ms ease,
			box-shadow 180ms ease,
			transform 180ms ease;
	}

	.hero-cta svg {
		width: 16px;
		height: 16px;
		transition: transform 180ms ease;
	}

	.hero-cta:hover {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--color-bicop-violet) 82%, transparent);
		background: color-mix(in srgb, var(--color-bicop-night) 72%, var(--color-bicop-stage));
		box-shadow:
			0 10px 28px rgb(0 0 0 / 34%),
			0 0 22px color-mix(in srgb, var(--color-bicop-violet) 16%, transparent);
	}

	.hero-cta:hover svg {
		transform: translateX(1px);
	}

	.hero-cta:focus-visible {
		outline: 2px solid var(--color-bicop-ice);
		outline-offset: 4px;
	}

	.wordmark-period {
		color: var(--color-bicop-violet);
	}

	@media (min-width: 1440px) {
		.hero {
			min-height: 920px;
		}
	}

	@media (max-width: 950px) {
		.hero-photo {
			width: min(72vw, 680px);
		}

		.hero-wordmark {
			font-size: clamp(98px, 15vw, 142px);
		}

		.hero-lockup {
			gap: 20px;
		}
	}

	@media (max-width: 640px) {
		.hero {
			min-height: max(790px, 100svh);
			align-items: flex-start;
		}

		.hero-photo {
			--photo-mask:
				linear-gradient(to right, transparent 0%, #000 19%, #000 81%, transparent 100%),
				linear-gradient(to bottom, transparent 0%, #000 8%, #000 82%, transparent 100%);

			top: clamp(5.5rem, 13svh, 7rem);
			width: min(92vw, 540px);
			height: 68%;
			min-height: 0;
		}

		.hero-lockup {
			bottom: 11%;
			gap: 17px;
		}

		.hero-wordmark {
			font-size: clamp(91px, 22vw, 145px);
		}

		.hero-wordmark > span:first-child {
			font-size: 0.36em;
		}

		.hero-action {
			gap: 11px;
		}

		.hero-descriptor {
			font-size: 10px;
			letter-spacing: 0.12em;
		}

		.hero-cta {
			width: min(100%, 260px);
			min-height: 50px;
		}
	}

	@media (max-width: 640px) and (max-height: 740px) {
		.hero-lockup {
			bottom: max(16%, calc(100% - 620px));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-cta,
		.hero-cta svg {
			transition: none;
		}

		.hero-cta:hover {
			transform: none;
		}
	}

</style>
